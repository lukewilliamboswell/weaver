#!/usr/bin/env roc-stable
app [main!] {
	cli: platform "https://github.com/roc-lang/basic-cli/releases/download/0.25.0/CZsY7tYZwR3rj9kYbpaCfxki2yVAaRL8bBwMLvB2xkbA.tar.zst",
}

import cli.Cmd
import cli.Env
import cli.OsStr
import cli.Path
import src/Files
import src/Script
import src/Site

Case : {
	args : Try(List(Str), [Missing]),
	unix_args_hex : Try(List(Str), [Missing]),
	exit_code : Try(I32, [Missing]),
}

main! = |_args| {
	# Assemble the authored site in www/ with fresh API documentation and the
	# real terminal output of every example. DOCS_OUTPUT is the destination
	# (default pages-site) and ROC_DOCS_URL_ROOT is where the API docs will be
	# served from (default /weaver/main). The package is documented and the
	# examples are built with the floating nightly.
	roc_nightly = Script.roc_nightly!()?
	output = Path.absolute!(Path.utf8(Script.env_str!("DOCS_OUTPUT") ?? "pages-site"))?
	url_root = Script.env_str!("ROC_DOCS_URL_ROOT") ?? "/weaver/main"

	marker = Path.join(output, ".weaver-docs-site")
	if Path.exists!(output)? {
		if !Path.is_file!(marker)? {
			return Script.fail!("refusing to replace ${Path.display(output)}: it was not created by this script")
		}
		Path.delete_all!(output)?
	}
	Path.copy_dir!("www", output)?
	Path.write_utf8!(marker, "generated by scripts/build_docs.roc\n")?

	Script.info!("+", "${OsStr.display(roc_nightly.program())} docs package/main.roc")?
	roc_nightly
		.cmd(["docs", "package/main.roc", OsStr.from_str("--output=${Path.display(Path.join(output, "main"))}")])
		.env_str("ROC_DOCS_URL_ROOT", Str.drop_suffix(url_root, "/"))
		.exec_cmd!()?

	add_examples!(roc_nightly, output)?
	enhance_api_pages!(output)?
	Script.info!("DONE", "assembled the documentation site in ${Path.display(output)}")
}

add_examples! = |roc_nightly, output| {
	spec : { apps : List({ path : Str, cases : List(Case) }) }
	spec = Json.parse(Path.read_utf8!("tests/spec.json")?).map_err(|err| InvalidSpec(err))?
	cards = Env.with_temp_dir!(
		|build_dir|
			spec.apps.map_try!(
				|example| {
					name = Files.stem(Str.drop_prefix(example.path, "examples/"))
					executable = Path.join(build_dir, name)
					roc_nightly.run!(["build", OsStr.from_str(example.path), OsStr.from_str("--output=${Path.display(executable)}"), "--no-cache"])?

					# Show the first case that succeeds and that a reader could type.
					args = match example.cases.find_first(|case| (case.exit_code ?? 0) == 0 and (case.unix_args_hex ?? []).is_empty()) {
						Ok(case) => case.args ?? []
						Err(_) => return Script.fail!("${example.path} has no successful representative case")
					}
					shown = Cmd.new(Path.to_os_str(executable))
						.args(args.map(OsStr.from_str))
						.merge_stderr(Bool.True)
						.exec_output!()
						.map_err(|err| ExampleFailed(example.path, Str.inspect(err)))?
					Script.info!("CAPTURED", name)?
					Ok(Site.example_card(name, Site.shell_join(["./${name}"].concat(args)), shown.stdout_utf8))
				},
			),
	)?
	index = Path.join(output, "index.html")
	Path.write_utf8!(index, Site.insert_examples(Path.read_utf8!(index)?, cards)?)?
	Script.info!("ADDED", "${cards.len().to_str()} examples to the landing page")
}

enhance_api_pages! = |output| {
	for asset in ["roc-highlight.js", "roc-highlight.css", "docs-extras.css"] {
		if !Path.is_file!(Path.join(output, asset))? {
			return Script.fail!("missing site asset: ${asset}")
		}
	}
	root = "${Path.display(output).replace_each("\\", "/")}/"
	var $changed = 0
	for page in Files.all_files_with_ext!(Path.join(output, "main"), "html")? {
		# main/index.html is one directory below the site root, main/Cli/index.html two.
		relative = Str.drop_prefix(Path.display(page).replace_each("\\", "/"), root)
		depth = Str.split_on(relative, "/").len() - 1
		match Site.enhance_api_page(Path.read_utf8!(page)?, depth).map_err(|err| CannotEnhance(relative, err))? {
			Changed(document) => {
				Path.write_utf8!(page, document)?
				$changed = $changed + 1
			}
			Unchanged => {}
		}
	}
	Script.info!("BRANDED", pages($changed))
}

pages : U64 -> Str
pages = |count| "${count.to_str()} API documentation pages"
